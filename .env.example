# API runtime
GRAFY_WORKSPACE=.grafy-artifacts/workbench
GRAFY_DATABASE_URL=sqlite+aiosqlite:///.grafy-artifacts/workbench/grafy.sqlite3
# Human-readable local logs. Production should use the JSON renderer.
GRAFY_LOG_LEVEL=INFO
GRAFY_LOG_RENDERER=console
# Exact browser origin. Local Next.js proxies /api → API, so keep this on :3000.
GRAFY_PUBLIC_ORIGIN=http://localhost:3000
GRAFY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Local HTTP must disable Secure cookies; production Compose keeps the default.
GRAFY_AUTH_COOKIE_SECURE=false
# Maximum concurrent MAP items within one graph execution.
GRAFY_MAP_MAX_CONCURRENCY=4
# Process-wide active graph budget. Saved-graph executions wait in the queue;
# synchronous draft/diagnostic runs fail fast when every slot is occupied.
GRAFY_MAX_ACTIVE_EXECUTIONS=2
# Durable saved-graph executions accepted while waiting for an active slot.
GRAFY_MAX_PENDING_GRAPHS=20
# Independent Workspace Plugin execution resource budgets.
GRAFY_MAX_ACTIVE_PLUGIN_INVOCATIONS=4
# Optional JSON object of exact Plugin slugs to bounded invocation wall times.
GRAFY_PLUGIN_INVOCATION_WALL_TIME_SECONDS_BY_SLUG={}
GRAFY_MAX_LIVE_PLUGIN_SANDBOXES=4
GRAFY_MAX_DISTINCT_PLUGIN_RELEASES_PER_GRAPH=4
# Origin-keyed sandboxes turn one release into variants; must stay within the
# live-sandbox budget.
GRAFY_MAX_PLUGIN_SANDBOX_VARIANTS_PER_EXECUTION=4
# Stable standard-base64 encoding of 32 random bytes. Required to configure or
# use write-only node secrets; generate once with: openssl rand -base64 32
GRAFY_CREDENTIAL_ENCRYPTION_KEY=
# Server-keyed HMAC material for collaboration command and execution digests.
# Required for API startup; generate once with: openssl rand -base64 32
GRAFY_COMMAND_HMAC_KEY=
GRAFY_COMMAND_HMAC_KEY_VERSION=1
# Collaboration assumes one API process/worker. Production Compose keeps this
# true and acquires an exclusive workspace lock at startup.
# GRAFY_REQUIRE_SINGLE_API_OWNER=true

# Local Keycloak (just keycloak-up). See infra/keycloak/README.md.
GRAFY_OIDC_ISSUER=http://keycloak.localhost:8081/realms/grafy
GRAFY_OIDC_CLIENT_ID=grafy-web
# Public PKCE client — leave secret unset for the imported grafy-web client.
# GRAFY_OIDC_CLIENT_SECRET=
GRAFY_OIDC_AUTH_WRAPPING_KEY=
GRAFY_OIDC_AUTH_WRAPPING_KEY_VERSION=1
# Fixed subject of the imported Keycloak user `owner` / `owner`.
GRAFY_OIDC_BOOTSTRAP_SUBJECT=11111111-1111-4111-8111-111111111111
# Issuer-asserted email domains that join a shared Workspace on login: domain:slug[:name]
# GRAFY_OIDC_DOMAIN_WORKSPACES=ihpan.edu.pl:ihpan:IHPAN

# Graph-room application heartbeat interval (seconds). Revalidates membership
# when a post-commit room invalidation is lost. Set 0 to disable.
# GRAFY_GRAPH_ROOM_HEARTBEAT_SECONDS=15
# Ephemeral presence TTL (seconds) and best-effort update budget.
# GRAFY_GRAPH_ROOM_PRESENCE_TTL_SECONDS=5
# GRAFY_GRAPH_ROOM_PRESENCE_MAX_UPDATES_PER_SECOND=20
GRAFY_STORAGE_BACKEND=local
# JSON array of allowlisted roots for `grafy plugin publish`. Checked-in System
# packages and mutable Workspace working copies intentionally use separate roots.
GRAFY_PLUGIN_ROOTS=["examples","plugins",".grafy-artifacts/workspace-plugins"]
# Coding-agent working copies are further namespaced by Workspace UUID. The
# deployment-owned SDK project vendors a fixed grafy-core wheel into each copy.
GRAFY_PLUGIN_AUTHORING_ROOT=.grafy-artifacts/workspace-plugins
GRAFY_PLUGIN_SDK_PROJECT=libs/core
# Optional exact System Plugin host deployment manifest. When omitted, the API
# starts with Module boundaries only and executes eligible releases in isolation.
# GRAFY_SYSTEM_PLUGIN_DEPLOYMENT_MANIFEST=/run/grafy/system-plugins.json
# Workspace Plugin execution stays disabled unless the local Docker sandbox
# owner is explicitly enabled. Enabling it gives the API process Docker-daemon
# authority; see infra/docker/README.md before using this in production.
GRAFY_PLUGIN_RUNTIME_ENABLED=false
GRAFY_PLUGIN_RUNTIME_PROFILE=python-uv
# Native profiles remain unavailable unless both values identify one
# deployment-owned, immutable base image. The image must already contain the
# exact GDAL/Tesseract runtime selected by GRAFY_PLUGIN_RUNTIME_PROFILE.
# GRAFY_PLUGIN_RUNTIME_NATIVE_BASE_IMAGE=registry.example/grafy/plugin-native
# GRAFY_PLUGIN_RUNTIME_NATIVE_BASE_IMAGE_DIGEST=<64 lowercase hex characters>
GRAFY_PLUGIN_DOCKER_BINARY=docker
# Docker must be able to bind this host path into publisher containers.
GRAFY_PLUGIN_PUBLISHER_SCRATCH_ROOT=.grafy-artifacts/plugin-publisher
# Optional path to a deployment-owned seccomp JSON profile.
# GRAFY_PLUGIN_RUNTIME_SECCOMP_PROFILE=
# Network access profiles are deployment-owned; Plugin source may request
# authority but never grant it. Without a manifest, the legacy variables
# below translate into a curated compatibility profile for historical
# network.egress releases and emit a deprecation warning.
# GRAFY_NETWORK_POLICY_MANIFEST=/etc/grafy/network-policy.toml
# Legacy plugin-execution egress; superseded by GRAFY_NETWORK_POLICY_MANIFEST.
# GRAFY_PLUGIN_EGRESS_BROKER_IMAGE=registry.example/grafy/plugin-egress-broker@sha256:<digest>
# GRAFY_PLUGIN_HTTP_EGRESS_DESTINATIONS=["https://api.example.com:443"]
# The separate postgresql.egress capability keeps its destination-scoped list.
# GRAFY_PLUGIN_POSTGRESQL_EGRESS_DESTINATIONS=["postgresql://database.example.com:5432"]
GRAFY_STORAGE_BUCKET=workbench-artifacts
# Per-file limit (1-64 MiB); values above 64 MiB are rejected by API settings.
GRAFY_STAGED_UPLOAD_MAX_BYTES=67108864

# Set GRAFY_STORAGE_BACKEND=s3 for AWS S3 or an S3-compatible service such as MinIO.
# GRAFY_S3_ENDPOINT_URL=http://localhost:9000
# GRAFY_S3_REGION=us-east-1
# GRAFY_S3_ACCESS_KEY_ID=
# GRAFY_S3_SECRET_ACCESS_KEY=
# GRAFY_S3_FORCE_PATH_STYLE=true
