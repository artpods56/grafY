# API runtime
GRAFY_WORKSPACE=.grafy-artifacts/workbench
GRAFY_DATABASE_URL=sqlite+aiosqlite:///.grafy-artifacts/workbench/grafy.sqlite3
# Human-readable local logs. Production should use the JSON renderer.
GRAFY_LOG_LEVEL=INFO
GRAFY_LOG_RENDERER=console
# Exact browser origin. Local Next.js proxies /api → API, so keep this on :3000.
GRAFY_PUBLIC_ORIGIN=http://localhost:3000
GRAFY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Local HTTP must disable Secure cookies; production Compose keeps the default.
GRAFY_AUTH_COOKIE_SECURE=false
# Maximum concurrent MAP items within one graph execution.
GRAFY_MAP_MAX_CONCURRENCY=4
# Concurrent computations per Project; Runs share this budget.
GRAFY_PROJECT_COMPUTATION_CONCURRENCY=2
# Durable saved-graph executions accepted while waiting for an active slot.
# Stable standard-base64 encoding of 32 random bytes. Required to configure or
# use write-only node secrets; generate once with: openssl rand -base64 32
GRAFY_CREDENTIAL_ENCRYPTION_KEY=
# Server-keyed HMAC material for collaboration command and execution digests.
# Required for API startup; generate once with: openssl rand -base64 32
GRAFY_COMMAND_HMAC_KEY=
GRAFY_COMMAND_HMAC_KEY_VERSION=1
# Collaboration assumes one API process/worker. Production Compose keeps this
# true and acquires an exclusive workspace lock at startup.
# GRAFY_REQUIRE_SINGLE_API_OWNER=true

# Local Keycloak (just keycloak-up). See infra/keycloak/README.md.
GRAFY_OIDC_ISSUER=http://keycloak.localhost:8081/realms/grafy
GRAFY_OIDC_CLIENT_ID=grafy-web
# Public PKCE client — leave secret unset for the imported grafy-web client.
# GRAFY_OIDC_CLIENT_SECRET=
GRAFY_OIDC_AUTH_WRAPPING_KEY=
GRAFY_OIDC_AUTH_WRAPPING_KEY_VERSION=1
# Fixed subject of the imported Keycloak user `owner` / `owner`.
GRAFY_OIDC_BOOTSTRAP_SUBJECT=11111111-1111-4111-8111-111111111111
# Issuer-asserted email domains that join a shared Workspace on login: domain:slug[:name]
# GRAFY_OIDC_DOMAIN_WORKSPACES=ihpan.edu.pl:ihpan:IHPAN

# Graph-room application heartbeat interval (seconds). Revalidates membership
# when a post-commit room invalidation is lost. Set 0 to disable.
# GRAFY_GRAPH_ROOM_HEARTBEAT_SECONDS=15
# Ephemeral presence TTL (seconds) and best-effort update budget.
# GRAFY_GRAPH_ROOM_PRESENCE_TTL_SECONDS=5
# GRAFY_GRAPH_ROOM_PRESENCE_MAX_UPDATES_PER_SECOND=20
GRAFY_STORAGE_BACKEND=local
# Destinations node configuration may reach even though they are not public
# addresses (ADR 0017): a self-hosted database behind a private address, or a
# model server on the local network. What an author can name never widens this.
# GRAFY_EGRESS_TRUSTED_DESTINATIONS=["models.internal:11434", "10.0.0.8"]
GRAFY_STORAGE_BUCKET=workbench-artifacts
# Deployment default Agent model (ADR 0021): an Agent uses these three unless whoever
# configures it gives it an endpoint and key of its own. All three are needed before an
# Agent can answer; leave them unset to leave Agents without a default model. The
# endpoint may name a trusted private destination listed above, and it is dialed through
# the same pinned public-address transport as an LLM node's base_url.
# GRAFY_AGENT_DEFAULT_BASE_URL=https://api.openai.com/v1
# GRAFY_AGENT_DEFAULT_MODEL=gpt-5-mini
# GRAFY_AGENT_DEFAULT_API_KEY=
# Per-file limit (1-64 MiB); values above 64 MiB are rejected by API settings.
GRAFY_STAGED_UPLOAD_MAX_BYTES=67108864

# Set GRAFY_STORAGE_BACKEND=s3 for AWS S3 or an S3-compatible service such as MinIO.
# GRAFY_S3_ENDPOINT_URL=http://localhost:9000
# Browser-facing upload endpoint when it differs from the internal endpoint.
# A path (the Compose gateway's /storage) is stripped by the proxy and is not signed.
# GRAFY_S3_SIGNING_ENDPOINT_URL=https://grafy.example.com/storage
# GRAFY_S3_REGION=us-east-1
# GRAFY_S3_ACCESS_KEY_ID=
# GRAFY_S3_SECRET_ACCESS_KEY=
# GRAFY_S3_FORCE_PATH_STYLE=true
# Bound the receive window for local API PUTs and require the same bound on the
# MinIO/proxy path. Cleanup retains terminal upload rows until target TTL plus
# this window have elapsed.
# GRAFY_UPLOAD_LIFETIME_SECONDS=86400
# GRAFY_UPLOAD_TARGET_TTL_SECONDS=900
# GRAFY_UPLOAD_RECEIVE_TIMEOUT_SECONDS=1800
