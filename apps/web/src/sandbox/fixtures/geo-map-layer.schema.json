{
  "$defs": {
    "ArtifactRef": {
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "title": "Artifact Type",
          "type": "string"
        },
        "schema_version": {
          "title": "Schema Version",
          "type": "integer"
        },
        "content_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        }
      },
      "required": ["artifact_id", "artifact_type", "schema_version"],
      "title": "ArtifactRef",
      "type": "object"
    },
    "GeoCategorizedPointStyle": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "categorized_points",
          "default": "categorized_points",
          "title": "Kind",
          "type": "string"
        },
        "category_property": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Category Property",
          "type": "string"
        },
        "categories": {
          "items": {
            "$ref": "#/$defs/GeoPointCategory"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Categories",
          "type": "array"
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeoLabelStyle"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": ["category_property", "categories"],
      "title": "GeoCategorizedPointStyle",
      "type": "object"
    },
    "GeoCategoryValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        }
      ]
    },
    "GeoFeatureArtifactSource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "feature_collection",
          "default": "feature_collection",
          "title": "Kind",
          "type": "string"
        },
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": ["artifact"],
      "title": "GeoFeatureArtifactSource",
      "type": "object"
    },
    "GeoFillStyle": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "color": {
          "default": "#2563eb",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Color",
          "type": "string"
        },
        "opacity": {
          "default": 0.45,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Opacity",
          "type": "number"
        }
      },
      "title": "GeoFillStyle",
      "type": "object"
    },
    "GeoLabelStyle": {
      "additionalProperties": false,
      "properties": {
        "property": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Property",
          "type": "string"
        },
        "color": {
          "default": "#111827",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Color",
          "type": "string"
        },
        "size": {
          "default": 12.0,
          "maximum": 72.0,
          "minimum": 6.0,
          "title": "Size",
          "type": "number"
        },
        "halo_color": {
          "default": "#ffffff",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Halo Color",
          "type": "string"
        },
        "halo_width": {
          "default": 1.0,
          "maximum": 16.0,
          "minimum": 0.0,
          "title": "Halo Width",
          "type": "number"
        }
      },
      "required": ["property"],
      "title": "GeoLabelStyle",
      "type": "object"
    },
    "GeoLineStyle": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "color": {
          "default": "#1d4ed8",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Color",
          "type": "string"
        },
        "opacity": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Opacity",
          "type": "number"
        },
        "width": {
          "default": 1.5,
          "maximum": 64.0,
          "minimum": 0.0,
          "title": "Width",
          "type": "number"
        }
      },
      "title": "GeoLineStyle",
      "type": "object"
    },
    "GeoPointCategory": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "values": {
          "items": {
            "$ref": "#/$defs/GeoCategoryValue"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Values",
          "type": "array"
        },
        "point": {
          "$ref": "#/$defs/GeoPointStyle"
        },
        "min_zoom": {
          "default": 0,
          "maximum": 24,
          "minimum": 0,
          "title": "Min Zoom",
          "type": "integer"
        },
        "max_zoom": {
          "default": 22,
          "maximum": 24,
          "minimum": 0,
          "title": "Max Zoom",
          "type": "integer"
        }
      },
      "required": ["id", "title", "values"],
      "title": "GeoPointCategory",
      "type": "object"
    },
    "GeoPointStyle": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "color": {
          "default": "#dc2626",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Color",
          "type": "string"
        },
        "opacity": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Opacity",
          "type": "number"
        },
        "radius": {
          "default": 5.0,
          "maximum": 128.0,
          "minimum": 0.0,
          "title": "Radius",
          "type": "number"
        },
        "stroke_color": {
          "default": "#ffffff",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Stroke Color",
          "type": "string"
        },
        "stroke_width": {
          "default": 1.0,
          "maximum": 32.0,
          "minimum": 0.0,
          "title": "Stroke Width",
          "type": "number"
        }
      },
      "title": "GeoPointStyle",
      "type": "object"
    },
    "GeoRasterArtifactSource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "raster_scan",
          "default": "raster_scan",
          "title": "Kind",
          "type": "string"
        },
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": ["artifact"],
      "title": "GeoRasterArtifactSource",
      "type": "object"
    },
    "GeoRasterStyle": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "raster",
          "default": "raster",
          "title": "Kind",
          "type": "string"
        },
        "opacity": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Opacity",
          "type": "number"
        },
        "brightness_min": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Brightness Min",
          "type": "number"
        },
        "brightness_max": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Brightness Max",
          "type": "number"
        },
        "contrast": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": -1.0,
          "title": "Contrast",
          "type": "number"
        },
        "saturation": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": -1.0,
          "title": "Saturation",
          "type": "number"
        },
        "hue": {
          "default": 0.0,
          "maximum": 359.0,
          "minimum": 0.0,
          "title": "Hue",
          "type": "number"
        },
        "resampling": {
          "default": "linear",
          "enum": ["linear", "nearest"],
          "title": "Resampling",
          "type": "string"
        }
      },
      "title": "GeoRasterStyle",
      "type": "object"
    },
    "GeoVectorStyle": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "vector",
          "default": "vector",
          "title": "Kind",
          "type": "string"
        },
        "fill": {
          "$ref": "#/$defs/GeoFillStyle"
        },
        "line": {
          "$ref": "#/$defs/GeoLineStyle"
        },
        "outline": {
          "$ref": "#/$defs/GeoLineStyle"
        },
        "point": {
          "$ref": "#/$defs/GeoPointStyle"
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeoLabelStyle"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "GeoVectorStyle",
      "type": "object"
    },
    "GeoWmsSource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "wms",
          "default": "wms",
          "title": "Kind",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "layer": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Layer",
          "type": "string"
        },
        "version": {
          "default": "1.3.0",
          "enum": ["1.1.1", "1.3.0"],
          "title": "Version",
          "type": "string"
        },
        "format": {
          "default": "image/png",
          "enum": ["image/png", "image/jpeg"],
          "title": "Format",
          "type": "string"
        },
        "bounds": {
          "description": "WGS84 bounds ordered as west longitude, south latitude, east longitude, north latitude.",
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "maximum": 180.0,
              "minimum": -180.0,
              "title": "West longitude",
              "type": "number"
            },
            {
              "maximum": 90.0,
              "minimum": -90.0,
              "title": "South latitude",
              "type": "number"
            },
            {
              "maximum": 180.0,
              "minimum": -180.0,
              "title": "East longitude",
              "type": "number"
            },
            {
              "maximum": 90.0,
              "minimum": -90.0,
              "title": "North latitude",
              "type": "number"
            }
          ],
          "title": "Bounds",
          "type": "array"
        },
        "attribution": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Attribution",
          "type": "string"
        },
        "style_name": {
          "anyOf": [
            {
              "maxLength": 1024,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Style Name"
        }
      },
      "required": ["url", "layer", "bounds", "attribution"],
      "title": "GeoWmsSource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Lightweight display instructions for one vector, raster, or WMS source.",
  "properties": {
    "title": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "visible": {
      "default": true,
      "title": "Visible",
      "type": "boolean"
    },
    "opacity": {
      "default": 1.0,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Opacity",
      "type": "number"
    },
    "min_zoom": {
      "default": 0,
      "maximum": 24,
      "minimum": 0,
      "title": "Min Zoom",
      "type": "integer"
    },
    "max_zoom": {
      "default": 22,
      "maximum": 24,
      "minimum": 0,
      "title": "Max Zoom",
      "type": "integer"
    },
    "source": {
      "discriminator": {
        "mapping": {
          "feature_collection": "#/$defs/GeoFeatureArtifactSource",
          "raster_scan": "#/$defs/GeoRasterArtifactSource",
          "wms": "#/$defs/GeoWmsSource"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/GeoFeatureArtifactSource"
        },
        {
          "$ref": "#/$defs/GeoRasterArtifactSource"
        },
        {
          "$ref": "#/$defs/GeoWmsSource"
        }
      ],
      "title": "Source"
    },
    "style": {
      "discriminator": {
        "mapping": {
          "categorized_points": "#/$defs/GeoCategorizedPointStyle",
          "raster": "#/$defs/GeoRasterStyle",
          "vector": "#/$defs/GeoVectorStyle"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/GeoVectorStyle"
        },
        {
          "$ref": "#/$defs/GeoCategorizedPointStyle"
        },
        {
          "$ref": "#/$defs/GeoRasterStyle"
        }
      ],
      "title": "Style"
    }
  },
  "required": ["title", "source", "style"],
  "title": "GeoMapLayer",
  "type": "object"
}
