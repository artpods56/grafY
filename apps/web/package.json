{
  "name": "grafy-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "generate:api:schema": "uv run --directory ../.. --package grafy-api python -m grafy_api.openapi apps/web/openapi/grafy.json",
    "generate:api": "npm run generate:api:schema && openapi-typescript openapi/grafy.json --immutable --alphabetize --empty-objects-unknown -o src/lib/api/generated/grafy.ts",
    "check:api": "npm run generate:api:schema && openapi-typescript openapi/grafy.json --immutable --alphabetize --empty-objects-unknown -o src/lib/api/generated/grafy.ts --check"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@stylexjs/stylex": "^0.19.0",
    "@xyflow/react": "^12.11.1",
    "lucide-react": "^1.22.0",
    "maplibre-gl": "^3.6.2",
    "markdown-to-jsx": "8.0.0",
    "next": "16.2.9",
    "pmtiles": "^4.4.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "swr": "^2.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@stylexjs/babel-plugin": "^0.19.0",
    "@stylexjs/postcss-plugin": "^0.19.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
