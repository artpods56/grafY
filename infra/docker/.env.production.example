# Compose publishes the same-origin gateway on loopback only. Web and API stay
# on the internal Docker network.
GRAFY_BIND_ADDRESS=127.0.0.1
GRAFY_GATEWAY_PORT=8080
# Uvicorn trusts forwarded headers from the configured Compose subnet because
# the gateway container receives a dynamic address within it. Keep the subnet
# and bridge gateway aligned; override both if they overlap another network.
GRAFY_DOCKER_SUBNET=172.30.0.0/24
GRAFY_DOCKER_GATEWAY=172.30.0.1
GRAFY_DOCKER_NETWORK=grafy-internal
GRAFY_DATA_VOLUME=grafy-data

# Exact operator-provided HTTPS origin registered with the OIDC provider.
# Include a port only when that separate TLS endpoint uses a non-default port.
GRAFY_PUBLIC_ORIGIN=https://grafy.example.com
GRAFY_CORS_ORIGINS=https://grafy.example.com
GRAFY_ENVIRONMENT=production
# GRAFY_BUILD_DIGEST is baked into the release API image. Do not set it here:
# a value in this file, even an empty one, overrides the image.
GRAFY_LOG_LEVEL=INFO
GRAFY_LOG_RENDERER=json

# MAP item concurrency inside one graph execution.
GRAFY_MAP_MAX_CONCURRENCY=4
# Process-wide active graph budget. Saved-graph executions wait in the queue;
# synchronous draft/diagnostic runs fail fast when every slot is occupied.
GRAFY_MAX_ACTIVE_EXECUTIONS=2
GRAFY_MAX_PENDING_GRAPHS=20
# Independent Workspace Plugin execution resource budgets.
GRAFY_MAX_ACTIVE_PLUGIN_INVOCATIONS=4
GRAFY_MAX_LIVE_PLUGIN_SANDBOXES=4
GRAFY_MAX_DISTINCT_PLUGIN_RELEASES_PER_GRAPH=4

# Generate an independent value for each key with: openssl rand -base64 32
# Back them up. Changing them makes existing encrypted secrets, login
# transactions, or collaboration digests unverifiable.
GRAFY_CREDENTIAL_ENCRYPTION_KEY=
GRAFY_COMMAND_HMAC_KEY=
GRAFY_COMMAND_HMAC_KEY_VERSION=1

# OIDC relying-party inputs. Issuer, client ID, and wrapping key are required.
GRAFY_OIDC_ISSUER=
GRAFY_OIDC_CLIENT_ID=
# Uncomment only for a confidential client; public PKCE clients leave it absent.
# GRAFY_OIDC_CLIENT_SECRET=
GRAFY_OIDC_ALLOWED_SIGNING_ALGORITHMS=["RS256"]
GRAFY_OIDC_AUTH_WRAPPING_KEY=
GRAFY_OIDC_AUTH_WRAPPING_KEY_VERSION=1
# Issuer-asserted email domains that join a shared Workspace on login: domain:slug[:name]
# GRAFY_OIDC_DOMAIN_WORKSPACES=ihpan.edu.pl:ihpan:IHPAN

# This Docker-only name cannot collide with the local development database URL.
# SQLite and local artifact storage share the durable grafy-data volume.
GRAFY_DOCKER_DATABASE_URL=sqlite+aiosqlite:////data/workbench/grafy.sqlite3
GRAFY_STORAGE_BACKEND=local
GRAFY_STORAGE_BUCKET=workbench-artifacts
# Per-file limit (1-64 MiB); values above 64 MiB are rejected by API settings.
GRAFY_STAGED_UPLOAD_MAX_BYTES=67108864

# Families execute inside the API. Do not add compose.plugin-runtime.yaml or
# mount the Docker socket. The API image supplies GDAL and its system bindings.
# Node destinations resolve to public addresses unless the operator grants an
# exact private destination here. Graph configuration cannot widen this list.
GRAFY_EGRESS_TRUSTED_DESTINATIONS=[]
# Example for a deployment-owned local model server:
# GRAFY_EGRESS_TRUSTED_DESTINATIONS=["models.internal:11434"]

# Optional provider configuration.
OPENAI_CUSTOM_HEADERS=

# Optional S3-compatible storage. Set GRAFY_STORAGE_BACKEND=s3 to use it.
# The API reaches the store at GRAFY_S3_ENDPOINT_URL (Docker-internal);
# browsers upload through the gateway's /storage/ location, so set
# GRAFY_S3_SIGNING_ENDPOINT_URL=${GRAFY_PUBLIC_ORIGIN}/storage and include
# compose.shared-storage.yaml. See docs/deploy/upload-storage.md.
GRAFY_S3_ENDPOINT_URL=
GRAFY_S3_SIGNING_ENDPOINT_URL=
GRAFY_S3_REGION=us-east-1
GRAFY_S3_ACCESS_KEY_ID=
GRAFY_S3_SECRET_ACCESS_KEY=
GRAFY_S3_FORCE_PATH_STYLE=false
